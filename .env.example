RDF_BACKEND=graphdb
RDF_URL=http://localhost:7200/
GRAPHDB_REPOSITORY=bitrix24_v2_parallel_2
RDF_USERNAME=
RDF_PASSWORD=
RDF_TIMEOUT=45
GRAPH_PREFIX=urn:bitrix24:entity:garpix-bitrix24-ru-v2-parallel:

# MCP server (read-only)
MCP_HOST=127.0.0.1
MCP_PORT=8090
MCP_MAX_ROWS=500
MCP_MAX_RESPONSE_BYTES=1000000
MCP_TIMEOUT=30

# AI agent (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=60
AGENT_MAX_HISTORY=12
AGENT_SYSTEM_PROMPT=

# The monitor binds to loopback by default and does not expose credentials to the browser.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8085