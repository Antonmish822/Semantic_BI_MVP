RDF_BACKEND=graphdb
RDF_URL=http://localhost:7200/
GRAPHDB_REPOSITORY=bitrix24_v2_parallel_2
RDF_USERNAME=
RDF_PASSWORD=
RDF_TIMEOUT=45
GRAPH_PREFIX=urn:bitrix24:entity:garpix-bitrix24-ru-v2-parallel:

# MCP server (read-only)
MCP_HOST=127.0.0.1
MCP_PORT=8090
MCP_MAX_ROWS=500
MCP_MAX_RESPONSE_BYTES=1000000
MCP_TIMEOUT=30

# Agent MCP override (local agent points to loopback)
AGENT_MCP_URL=http://127.0.0.1:8090

# AI agent (Polza.ai, OpenAI-compatible)
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_API_KEY=
POLZA_MODEL=polza-chat
POLZA_TIMEOUT=60
AGENT_MAX_HISTORY=12
AGENT_SYSTEM_PROMPT=

# The monitor binds to loopback by default and does not expose credentials to the browser.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8085

# Required to enable ontology file and graph administration; use a long random secret.
ONTOLOGY_ADMIN_TOKEN=

# Polza.ai ontology assistant. Keep the key only in server-side environment.
ONTOLOGY_AI_BASE_URL=https://polza.ai/api/v1
ONTOLOGY_AI_MODEL=openai/gpt-6-luna
ONTOLOGY_AI_TIMEOUT=60
ONTOLOGY_AI_MAX_TOOL_CALLS=4
