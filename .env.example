# GraphDB repository used by the CRM pulse monitor.
RDF_BACKEND=graphdb
RDF_URL=http://host.docker.internal:7200
RDF_URL_DOCKER=http://host.docker.internal:7200
GRAPHDB_REPOSITORY=bitrix24_v2_parallel_2
RDF_USERNAME=
RDF_PASSWORD=
RDF_TIMEOUT=45
GRAPH_PREFIX=urn:bitrix24:entity:garpix-bitrix24-ru-v2-parallel:

# The monitor binds to loopback by default and does not expose credentials to the browser.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8088

# OAuth (Yandex ID)
AUTH_ENABLED=0
AUTH_COOKIE_NAME=crm_pulse_session
AUTH_COOKIE_MAX_AGE=86400
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_SECURE=0
AUTH_ALLOWED_DOMAINS=
AUTH_LOGOUT_REDIRECT=/
AUTH_DEBUG=0
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://127.0.0.1:8088/auth/callback
YANDEX_SCOPES=login:email login:info
YANDEX_AUTH_URL=https://oauth.yandex.ru/authorize
YANDEX_TOKEN_URL=https://oauth.yandex.ru/token
YANDEX_PROFILE_URL=https://login.yandex.ru/info

# MCP server (read-only)
MCP_HOST=mcp-graphdb
MCP_PORT=8090
MCP_MAX_ROWS=500
MCP_MAX_RESPONSE_BYTES=1000000
MCP_TIMEOUT=90
MCP_DEBUG=1
AGENT_MODE=proxy
AGENT_BASE_URL=http://127.0.0.1:8091
AGENT_TIMEOUT=60
# Agent MCP override (container-to-container)
AGENT_MCP_URL=http://mcp-graphdb:8090
AGENT_DEBUG=1
AGENT_ALLOW_SPARQL=0
AGENT_CORS_ALLOW_ORIGINS=http://127.0.0.1:8088

# AI agent (Polza.ai, OpenAI-compatible)
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_API_KEY=
POLZA_MODEL=openai/gpt-6-luna
POLZA_TIMEOUT=180
AGENT_MAX_HISTORY=12
AGENT_SYSTEM_PROMPT="Ты — аналитический ассистент Semantic BI. Всегда отвечай по-русски. Для любых вопросов о данных обязательно вызывай MCP-инструменты. Запрещено придумывать SPARQL, префиксы, названия запросов или обращаться к графу напрямую. Если нужно понять схему — сначала вызови explain_schema. Затем получи список доступных шаблонов через list_queries и только потом вызывай run_named_query. Формат вызова инструмента: ОТВЕЧАЙ ТОЛЬКО JSON без текста и без оберток: {\"tool_call\":{\"name\":\"<tool>\",\"arguments\":{...}}}. Никогда не печатай JSON инструментов в обычный чат. После получения результата инструмента дай финальный ответ пользователю обычным текстом."