# RDF store. Local runs can use localhost; Docker uses RDF_URL_DOCKER.
RDF_BACKEND=graphdb
RDF_URL=http://localhost:7200/
RDF_URL_DOCKER=http://graphdb:7200
GRAPHDB_REPOSITORY=bitrix24_v2_parallel_2
RDF_USERNAME=
RDF_PASSWORD=
RDF_TIMEOUT=45
GRAPH_PREFIX=urn:bitrix24:entity:garpix-bitrix24-ru-v2-parallel:
ONTOLOGY_DATA_NAMESPACE=https://example.org/bitrix24#

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8085
CRM_PULSE_MONITOR_PORT=8088

# OAuth (Yandex ID); disabled unless AUTH_ENABLED=1.
AUTH_ENABLED=0
AUTH_COOKIE_NAME=crm_pulse_session
AUTH_COOKIE_MAX_AGE=86400
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_SECURE=0
AUTH_ALLOWED_DOMAINS=
AUTH_LOGOUT_REDIRECT=/
AUTH_DEBUG=0
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://127.0.0.1:8088/auth/callback
YANDEX_SCOPES=login:email login:info
YANDEX_AUTH_URL=https://oauth.yandex.ru/authorize
YANDEX_TOKEN_URL=https://oauth.yandex.ru/token
YANDEX_PROFILE_URL=https://login.yandex.ru/info

# MCP server (read-only)
MCP_HOST=127.0.0.1
MCP_PORT=8090
MCP_SERVER_PORT=8090
MCP_MAX_ROWS=500
MCP_MAX_RESPONSE_BYTES=1000000
MCP_TIMEOUT=90
MCP_DEBUG=0

# Dashboard-to-agent proxy; Compose overrides AGENT_BASE_URL for service DNS.
AGENT_MODE=proxy
AGENT_BASE_URL=http://127.0.0.1:8091
AGENT_SERVICE_PORT=8091
AGENT_TIMEOUT=60
AGENT_MCP_URL=http://127.0.0.1:8090
ONTOLOGY_MCP_URL=http://127.0.0.1:8090/mcp
AGENT_ALLOW_SPARQL=1
AGENT_CORS_ALLOW_ORIGINS=http://127.0.0.1:8088
AGENT_DEBUG=0
AGENT_MAX_HISTORY=12
AGENT_SYSTEM_PROMPT="Ты — аналитический ассистент Semantic BI. Всегда отвечай по-русски. Для вопросов о данных обязательно используй MCP. Не придумывай SPARQL, префиксы или имена шаблонов. Если нужно изучить схему, вызови explain_schema. Перед выбором шаблона получи актуальный список через list_queries; выбирай запрос по его описанию и параметрам, затем передавай в run_named_query точное имя из каталога. Если шаблон или параметры неясны, задай уточняющий вопрос."

# Polza.ai (OpenAI-compatible)
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_API_KEY=
POLZA_MODEL=openai/gpt-6-luna
POLZA_TIMEOUT=180

# Ontology file/GraphDB administration.
ONTOLOGY_ADMIN_TOKEN=
ONTOLOGY_QUARANTINE_DAYS=30
ONTOLOGY_AI_BASE_URL=https://polza.ai/api/v1
ONTOLOGY_AI_MODEL=openai/gpt-6-luna
ONTOLOGY_AI_TIMEOUT=60
ONTOLOGY_AI_MAX_TOOL_CALLS=4
