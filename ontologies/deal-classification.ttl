@prefix b24:  <https://example.org/bitrix24#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<urn:bitrix24:ontology:deal-classification>
    a owl:Ontology ;
    rdfs:label "Bitrix24 deal classification"@en ;
    rdfs:label "Классификация сделок Bitrix24"@ru ;
    rdfs:comment "Онтология описывает свойства сделки и проектный класс активных сделок."@ru .

b24:Deal a owl:Class ;
    rdfs:label "Сделка"@ru ;
    rdfs:label "Deal"@en ;
    rdfs:comment "Сущность сделки в модели Bitrix24."@ru .

b24:ActiveDeal a owl:Class ;
    rdfs:label "Активная сделка"@ru ;
    rdfs:comment "Подкласс сделки, предназначенный для обозначения активных сделок."@ru ;
    rdfs:subClassOf b24:Deal .

b24:Lead a owl:Class ;
    rdfs:label "Лид"@ru ;
    rdfs:comment "Сущность лида в модели Bitrix24."@ru .

b24:User a owl:Class ;
    rdfs:label "Сотрудник"@ru ;
    rdfs:comment "Пользователь Bitrix24, представленный в модели как сотрудник."@ru .

b24:stageCode a owl:DatatypeProperty ;
    rdfs:label "Код стадии"@ru ;
    rdfs:comment "Код стадии сделки."@ru ;
    rdfs:domain b24:Deal ;
    rdfs:range xsd:string .

b24:stageSemantic a owl:DatatypeProperty ;
    rdfs:label "Семантический статус стадии"@ru ;
    rdfs:comment "Семантический статус, связанный со стадией сделки."@ru ;
    rdfs:domain b24:Deal ;
    rdfs:range xsd:string .

b24:beginDate a owl:DatatypeProperty ;
    rdfs:label "Дата начала"@ru ;
    rdfs:comment "Дата и время начала сделки."@ru ;
    rdfs:domain b24:Deal ;
    rdfs:range xsd:dateTime .

b24:closeDate a owl:DatatypeProperty ;
    rdfs:label "Дата завершения"@ru ;
    rdfs:comment "Дата и время закрытия сделки."@ru ;
    rdfs:domain b24:Deal ;
    rdfs:range xsd:dateTime .

b24:opportunity a owl:DatatypeProperty ;
    rdfs:label "Сумма сделки"@ru ;
    rdfs:comment "Денежная сумма, указанная для сделки."@ru ;
    rdfs:domain b24:Deal ;
    rdfs:range xsd:decimal .

b24:currency a owl:DatatypeProperty ;
    rdfs:label "Валюта сделки"@ru ;
    rdfs:comment "Валюта, связанная с суммой сделки."@ru ;
    rdfs:domain b24:Deal ;
    rdfs:range xsd:string .

b24:isManualOpportunity a owl:DatatypeProperty ;
    rdfs:label "Сумма задана вручную"@ru ;
    rdfs:comment "Признак того, что сумма сделки задана вручную."@ru ;
    rdfs:domain b24:Deal ;
    rdfs:range xsd:boolean .

b24:lastActivityTime a owl:DatatypeProperty ;
    rdfs:label "Время последней активности"@ru ;
    rdfs:comment "Дата и время последней активности, связанной со сделкой."@ru ;
    rdfs:domain b24:Deal ;
    rdfs:range xsd:dateTime .

b24:originLead a owl:ObjectProperty ;
    rdfs:label "Исходный лид"@ru ;
    rdfs:comment "Связь сделки с лидом, из которого она возникла."@ru ;
    rdfs:domain b24:Deal ;
    rdfs:range b24:Lead .

b24:lastActivityBy a owl:ObjectProperty ;
    rdfs:label "Сотрудник последней активности"@ru ;
    rdfs:comment "Сотрудник, указанный для последней активности сделки."@ru ;
    rdfs:domain b24:Deal ;
    rdfs:range b24:User .

b24:company a owl:ObjectProperty ;
    rdfs:label "Компания сделки"@ru ;
    rdfs:comment "Связь сделки с компанией."@ru ;
    rdfs:domain b24:Deal .

b24:contact a owl:ObjectProperty ;
    rdfs:label "Контакт сделки"@ru ;
    rdfs:comment "Связь сделки с контактом."@ru ;
    rdfs:domain b24:Deal .

# Связи, специфичные для сделки, также позволяют вывести её тип.
b24:originLead a owl:ObjectProperty ;
    rdfs:domain b24:Deal ;
    rdfs:range b24:Lead .

b24:lastActivityBy a owl:ObjectProperty ;
    rdfs:domain b24:Deal ;
    rdfs:range b24:User .


b24:company a owl:ObjectProperty ;
    rdfs:domain b24:Deal .

b24:contact a owl:ObjectProperty ;
    rdfs:domain b24:Deal .

# Проектное расширение. Замените заполнитель на значение из требования.
b24:ActiveDeal a owl:Class ;
    rdfs:label "Активные сделки"@ru ;
    rdfs:subClassOf b24:Deal ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            b24:Deal
            [
                a owl:Restriction ;
                owl:onProperty b24:stageSemantic ;
                owl:hasValue "P"^^xsd:string
            ]
        )
    ] .
