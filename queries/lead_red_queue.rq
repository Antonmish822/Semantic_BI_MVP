# @mcp-query
# @mcp-description: Возвращает до 10 последних красных лидов по всей истории на момент as_of.
# Лид старше 2 часов, без активности в первые 2 часа, без связанной сделки любой стадии и без статуса CONVERTED.
# as_of — обязательный момент расчёта в UTC, ISO 8601. Результат построчный: лид, создание, источник и ответственный.
PREFIX b24: <https://example.org/bitrix24#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?lead ?created_at ?title ?source_code ?source_name ?manager_name
WHERE {
  VALUES ?as_of { {{as_of}} }
  {
    SELECT ?lead (MIN(?created_value) AS ?created_at)
    WHERE {
      VALUES ?as_of { {{as_of}} }
      GRAPH ?lead_graph { ?lead b24:createdAt ?created_raw }
      FILTER(STRSTARTS(STR(?lead_graph), {{graph_prefix}})
             && CONTAINS(STR(?lead_graph), ":lead:"))
      BIND(xsd:dateTime(STR(?created_raw)) AS ?created_value)
      FILTER(?created_value <= ?as_of)
    }
    GROUP BY ?lead
  }
  FILTER(?created_at <= (?as_of - "PT2H"^^xsd:dayTimeDuration))
  FILTER NOT EXISTS {
    GRAPH ?status_graph { ?lead b24:statusCode ?status_value }
    FILTER(STRSTARTS(STR(?status_graph), {{graph_prefix}})
           && CONTAINS(STR(?status_graph), ":lead:")
           && UCASE(STR(?status_value)) = "CONVERTED")
  }
  FILTER NOT EXISTS {
    GRAPH ?deal_graph { ?deal b24:originLead ?lead }
    FILTER(STRSTARTS(STR(?deal_graph), {{graph_prefix}})
           && CONTAINS(STR(?deal_graph), ":deal:"))
  }
  FILTER NOT EXISTS {
    GRAPH ?activity_graph {
      ?activity b24:owner ?lead ;
                b24:ownerTypeId "1" ;
                b24:createdAt ?activity_raw .
    }
    FILTER(STRSTARTS(STR(?activity_graph), {{graph_prefix}})
           && CONTAINS(STR(?activity_graph), ":activity:"))
    BIND(xsd:dateTime(STR(?activity_raw)) AS ?activity_at)
    FILTER(?activity_at >= ?created_at
           && ?activity_at <= (?created_at + "PT2H"^^xsd:dayTimeDuration))
  }
  OPTIONAL {
    SELECT ?lead (MIN(STR(?title_value)) AS ?title)
    WHERE {
      GRAPH ?g { ?lead b24:title ?title_value }
      FILTER(STRSTARTS(STR(?g), {{graph_prefix}})
             && CONTAINS(STR(?g), ":lead:"))
    }
    GROUP BY ?lead
  }
  OPTIONAL {
    SELECT ?lead (MIN(STR(?code_value)) AS ?source_code)
                  (MIN(STR(?name_value)) AS ?source_name)
    WHERE {
      GRAPH ?lg { ?lead b24:sourceCode ?code_value }
      FILTER(STRSTARTS(STR(?lg), {{graph_prefix}})
             && CONTAINS(STR(?lg), ":lead:"))
      OPTIONAL {
        GRAPH ?sg { ?source b24:code ?code_value ; b24:name ?name_value }
        FILTER(STRSTARTS(STR(?sg), {{graph_prefix}})
               && CONTAINS(STR(?sg), ":source:"))
      }
    }
    GROUP BY ?lead
  }
  OPTIONAL {
    SELECT ?lead (MIN(STR(?name_value)) AS ?manager_name)
    WHERE {
      GRAPH ?lg { ?lead b24:assignedTo ?assigned_to }
      FILTER(STRSTARTS(STR(?lg), {{graph_prefix}})
             && CONTAINS(STR(?lg), ":lead:"))
      GRAPH ?ug { ?assigned_to b24:fullName ?name_value }
      FILTER(STRSTARTS(STR(?ug), {{graph_prefix}})
             && CONTAINS(STR(?ug), ":user:"))
    }
    GROUP BY ?lead
  }
}
ORDER BY DESC(?created_at) STR(?lead)
LIMIT 10
