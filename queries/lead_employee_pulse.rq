# @mcp-query
# @mcp-description: Исходные данные для пульса сотрудников, назначенных на лиды.
# Для каждого лида возвращает assigned_to, дату создания, первую активность владельца-лида и первую связанную сделку P.
# Дополнительно возвращает недавнюю активность ответственного сотрудника для отбора активных сотрудников.
# Дневные средние и 30-дневные окна рассчитываются приложением, а не этим запросом.
PREFIX b24: <https://example.org/bitrix24#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?lead ?created_at ?first_activity_at ?converted_at ?assigned_to
       ?first_name ?last_name ?last_activity_at
WHERE {
  GRAPH ?lead_graph {
    ?lead b24:createdAt ?created_raw ;
          b24:assignedTo ?assigned_to .
  }
  FILTER(STRSTARTS(STR(?lead_graph), {{graph_prefix}})
         && CONTAINS(STR(?lead_graph), ":lead:"))
  BIND(xsd:dateTime(STR(?created_raw)) AS ?created_at)

  OPTIONAL {
    GRAPH ?first_name_graph { ?assigned_to b24:firstName ?first_name }
    FILTER(STRSTARTS(STR(?first_name_graph), {{graph_prefix}})
           && CONTAINS(STR(?first_name_graph), ":user:"))
  }
  OPTIONAL {
    GRAPH ?last_name_graph { ?assigned_to b24:lastName ?last_name }
    FILTER(STRSTARTS(STR(?last_name_graph), {{graph_prefix}})
           && CONTAINS(STR(?last_name_graph), ":user:"))
  }

  OPTIONAL {
    SELECT ?assigned_to (MAX(xsd:dateTime(STR(?activity_raw))) AS ?last_activity_at)
    WHERE {
      GRAPH ?activity_graph {
        ?activity b24:responsible ?assigned_to ;
                  b24:createdAt ?activity_raw .
      }
      FILTER(STRSTARTS(STR(?activity_graph), {{graph_prefix}})
             && CONTAINS(STR(?activity_graph), ":activity:"))
    }
    GROUP BY ?assigned_to
  }

  OPTIONAL {
    SELECT ?lead (MIN(xsd:dateTime(STR(?activity_raw))) AS ?first_activity_at)
    WHERE {
      GRAPH ?activity_graph {
        ?activity b24:owner ?lead ;
                  b24:ownerTypeId "1" ;
                  b24:createdAt ?activity_raw .
      }
      FILTER(STRSTARTS(STR(?activity_graph), {{graph_prefix}})
             && CONTAINS(STR(?activity_graph), ":activity:"))
    }
    GROUP BY ?lead
  }

  OPTIONAL {
    SELECT ?lead (MIN(xsd:dateTime(STR(?deal_raw))) AS ?converted_at)
    WHERE {
      GRAPH ?deal_graph {
        ?deal b24:originLead ?lead ;
              b24:stageSemantic "P" ;
              b24:createdAt ?deal_raw .
      }
      FILTER(STRSTARTS(STR(?deal_graph), {{graph_prefix}})
             && CONTAINS(STR(?deal_graph), ":deal:"))
    }
    GROUP BY ?lead
  }
}
