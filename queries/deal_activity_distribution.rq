# @mcp-query
# @mcp-description: Возвращает активные сделки P с category_code и исходным lastActivityTime.
# Само распределение по временным корзинам не вычисляется; сгруппируйте даты на стороне клиента.
# Подходит для построения графика давности последней активности; отсутствующая дата остаётся пустой.
PREFIX b24: <https://example.org/bitrix24#>

SELECT ?deal ?last_activity_raw ?category_code
WHERE {
  GRAPH ?deal_graph {
    ?deal b24:stageSemantic "P" ;
          b24:categoryCode ?category_code .
    OPTIONAL { ?deal b24:lastActivityTime ?last_activity_raw }
  }
  FILTER(STRSTARTS(STR(?deal_graph), {{graph_prefix}})
         && CONTAINS(STR(?deal_graph), ":deal:"))
}
