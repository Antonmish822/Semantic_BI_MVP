PREFIX b24: <https://example.org/bitrix24#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?activity ?subject ?activity_at ?deal ?deal_title
                ?deal_semantic ?stage_name ?employee ?employee_name
WHERE {
  VALUES ?selected_project { {{selected_project}} }
  GRAPH ?activity_graph {
    ?activity b24:owner ?deal ;
              b24:ownerTypeId "2" ;
              b24:createdAt ?activity_raw ;
              b24:responsible ?employee .
    OPTIONAL { ?activity b24:subject ?subject }
  }
  FILTER(STRSTARTS(STR(?activity_graph), {{graph_prefix}})
         && CONTAINS(STR(?activity_graph), ":activity:"))
  FILTER(?selected_project = "all" || EXISTS {
    GRAPH ?deal_category_graph {
      ?deal b24:categoryCode ?activity_category_code .
    }
    FILTER(STRSTARTS(STR(?deal_category_graph), {{graph_prefix}})
           && CONTAINS(STR(?deal_category_graph), ":deal:")
           && STR(?activity_category_code) = ?selected_project)
  })
  BIND(xsd:dateTime(STR(?activity_raw)) AS ?activity_at)

  OPTIONAL {
    GRAPH ?deal_graph { ?deal b24:title ?deal_title }
    FILTER(STRSTARTS(STR(?deal_graph), {{graph_prefix}})
           && CONTAINS(STR(?deal_graph), ":deal:"))
  }

  OPTIONAL {
    GRAPH ?deal_stage_graph {
      ?deal b24:stageSemantic ?deal_semantic ;
            b24:stageCode ?deal_stage_code ;
            b24:categoryCode ?deal_category_code .
    }
    FILTER(STRSTARTS(STR(?deal_stage_graph), {{graph_prefix}})
           && CONTAINS(STR(?deal_stage_graph), ":deal:"))
    BIND(IF(STR(?deal_category_code) = "0",
            "DEAL_STAGE",
            CONCAT("DEAL_STAGE_", STR(?deal_category_code))) AS ?stage_entity)
    BIND(IRI(CONCAT("https://example.org/bitrix24/stage/", ?stage_entity, "/",
                    ENCODE_FOR_URI(STR(?deal_stage_code)))) AS ?stage)
    OPTIONAL {
      GRAPH ?stage_graph {
        ?stage b24:name ?stage_name .
      }
      FILTER(STRSTARTS(STR(?stage_graph), {{graph_prefix}})
             && CONTAINS(STR(?stage_graph), ":stage:"))
    }
  }

  OPTIONAL {
    GRAPH ?user_graph { ?employee b24:fullName ?employee_name }
    FILTER(STRSTARTS(STR(?user_graph), {{graph_prefix}})
           && CONTAINS(STR(?user_graph), ":user:"))
  }

}
ORDER BY DESC(?activity_at)
LIMIT 20
