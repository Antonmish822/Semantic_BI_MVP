PREFIX b24: <https://example.org/bitrix24#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?lead ?title ?created_at ?first_activity_at
       ?assigned_to ?manager_name ?status_code ?source_code ?source_name ?has_converted_deal
WHERE {
  GRAPH ?lead_graph {
    ?lead b24:createdAt ?created_raw .
    OPTIONAL { ?lead b24:title ?title }
    OPTIONAL { ?lead b24:assignedTo ?assigned_to }
    OPTIONAL { ?lead b24:statusCode ?status_code }
    OPTIONAL { ?lead b24:sourceCode ?source_code }
  }
  FILTER(STRSTARTS(STR(?lead_graph), {{graph_prefix}})
         && CONTAINS(STR(?lead_graph), ":lead:"))
  BIND(xsd:dateTime(STR(?created_raw)) AS ?created_at)
  BIND(EXISTS {
    GRAPH ?linked_deal_graph { ?linked_deal b24:originLead ?lead }
    FILTER(STRSTARTS(STR(?linked_deal_graph), {{graph_prefix}})
           && CONTAINS(STR(?linked_deal_graph), ":deal:"))
  } AS ?has_converted_deal)

  OPTIONAL {
    GRAPH ?user_graph { ?assigned_to b24:fullName ?manager_name }
    FILTER(STRSTARTS(STR(?user_graph), {{graph_prefix}})
           && CONTAINS(STR(?user_graph), ":user:"))
  }

  OPTIONAL {
    GRAPH ?source_graph {
      ?source b24:code ?source_code ;
              b24:name ?source_name .
    }
    FILTER(STRSTARTS(STR(?source_graph), {{graph_prefix}})
           && CONTAINS(STR(?source_graph), ":source:"))
  }

  OPTIONAL {
    SELECT ?lead (MIN(xsd:dateTime(STR(?activity_raw))) AS ?first_activity_at)
    WHERE {
      GRAPH ?activity_graph {
        ?activity b24:owner ?lead ;
                  b24:ownerTypeId "1" ;
                  b24:createdAt ?activity_raw .
      }
      FILTER(STRSTARTS(STR(?activity_graph), {{graph_prefix}})
             && CONTAINS(STR(?activity_graph), ":activity:"))
    }
    GROUP BY ?lead
  }

  FILTER(?created_at <= (NOW() - "PT2H"^^xsd:duration))
  FILTER(!?has_converted_deal)
  FILTER(!BOUND(?status_code) || UCASE(STR(?status_code)) != "CONVERTED")
  FILTER(!BOUND(?first_activity_at) || ?first_activity_at > (?created_at + "PT2H"^^xsd:duration))
}
ORDER BY DESC(?created_at)
LIMIT 10
