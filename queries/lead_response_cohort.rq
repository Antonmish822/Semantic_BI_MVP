# @mcp-query
# @mcp-description: Возвращает лиды, созданные за 119 дней до as_of, и первую активность после создания.
# as_of — обязательный момент расчёта в UTC, ISO 8601, например 2026-11-23T12:00:00Z.
# Подходит для анализа реакций и дневных 30-дневных когорт; возвращает построчные данные по лидам, не итоговую SLA-долю.
PREFIX b24: <https://example.org/bitrix24#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?lead ?created_at (MIN(?activity_at) AS ?first_activity_at)
WHERE {
  VALUES ?as_of { {{as_of}} }
  BIND(?as_of - "P119D"^^xsd:dayTimeDuration AS ?cohort_start)
  {
    SELECT ?lead (MIN(?created_value) AS ?created_at)
    WHERE {
      VALUES ?as_of { {{as_of}} }
      BIND(?as_of - "P119D"^^xsd:dayTimeDuration AS ?cohort_start)
      GRAPH ?lead_graph { ?lead b24:createdAt ?created_raw }
      FILTER(STRSTARTS(STR(?lead_graph), {{graph_prefix}})
             && CONTAINS(STR(?lead_graph), ":lead:"))
      BIND(xsd:dateTime(STR(?created_raw)) AS ?created_value)
      FILTER(?created_value >= ?cohort_start && ?created_value <= ?as_of)
    }
    GROUP BY ?lead
  }
  OPTIONAL {
    GRAPH ?activity_graph {
      ?activity b24:owner ?lead ;
                b24:ownerTypeId "1" ;
                b24:createdAt ?activity_raw .
    }
    FILTER(STRSTARTS(STR(?activity_graph), {{graph_prefix}})
           && CONTAINS(STR(?activity_graph), ":activity:"))
    BIND(xsd:dateTime(STR(?activity_raw)) AS ?activity_at)
    FILTER(?activity_at >= ?created_at && ?activity_at <= ?as_of)
  }
}
GROUP BY ?lead ?created_at
